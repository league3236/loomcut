# 로컬 개발용 예시. 복사해서 .env로 사용 (.env는 커밋 금지)
DATABASE_URL=sqlite:///./db.sqlite3
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

VIDEO_PROVIDER=atlas
ATLAS_API_KEY=
ATLAS_BASE_URL=https://api.atlascloud.ai
DEFAULT_T2V_MODEL=bytedance/seedance-2.0/text-to-video
DEFAULT_I2V_MODEL=bytedance/seedance-2.0/image-to-video

CORS_ORIGINS=*
