# 로컬 개발용 예시. 복사해서 .env로 사용 (.env는 커밋 금지)
DATABASE_URL=sqlite:///./db.sqlite3
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 어드민 이메일 (쉼표 구분) — 크레딧 차감 없이 무료 생성
ADMIN_EMAILS=

# 과금: 모델별 초당 크레딧 (1크레딧 = 1원)
PRICE_PER_SECOND=400
PRICE_PER_SECOND_FAST=320
PRICE_PER_SECOND_MINI=65
DEFAULT_DURATION=5
DEFAULT_MODEL=seedance-2.0

# 이미지 업로드 최대 크기(MB)
MAX_UPLOAD_MB=20

# 토스페이먼츠 (테스트 키: test_ck_..., test_sk_...)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

VIDEO_PROVIDER=atlas
ATLAS_API_KEY=
ATLAS_BASE_URL=https://api.atlascloud.ai

CORS_ORIGINS=*
